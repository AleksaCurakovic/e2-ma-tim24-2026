<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorPrimary"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvSkockoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Skočko"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="4dp"/>

    <!-- Instruction -->
    <TextView
        android:id="@+id/tvSkockoInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pogodi kombinaciju!"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="8dp"/>

    <!-- Progress bar timer -->
    <ProgressBar
        android:id="@+id/skockoProgressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:max="100"
        android:progress="100"
        android:layout_marginBottom="12dp"/>

    <!-- Past attempts scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/layoutAttempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"/>

    </ScrollView>

    <!-- Current attempt row being built -->
    <LinearLayout
        android:id="@+id/layoutCurrentRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Filled dynamically by SkockoFragment -->

    </LinearLayout>

    <!-- Row action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="8dp">

        <Button
            android:id="@+id/btnClearAttempt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Obriši"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnSubmitAttempt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Potvrdi"/>

    </LinearLayout>

    <!-- Symbol picker -->
    <LinearLayout
        android:id="@+id/layoutSymbolPicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnSkocko"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:src="@drawable/skocko"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Skočko"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

        <ImageButton
            android:id="@+id/btnKvadrat"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:src="@drawable/square"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kvadrat"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

        <ImageButton
            android:id="@+id/btnKrug"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:src="@drawable/circle"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Krug"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

        <ImageButton
            android:id="@+id/btnSrce"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:src="@drawable/heart"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Srce"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

        <ImageButton
            android:id="@+id/btnTrougao"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:src="@drawable/triangle"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Trougao"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

        <ImageButton
            android:id="@+id/btnZvezda"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:src="@drawable/star"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zvezda"
            android:scaleType="fitCenter"
            android:padding="4dp"/>

    </LinearLayout>

</LinearLayout>